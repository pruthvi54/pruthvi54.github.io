---
import CopyButton from './CopyButton.astro';
import BookCallLink from './BookCallLink.astro';
import data from '../data/content.json';
const contact = data.profile.contact;
const year = new Date().getFullYear();
---
<footer class="site-footer page-width">
  <div class="footer-email"><a href={`mailto:${contact.email}`}>{contact.email}</a><CopyButton text={contact.email} /></div>
  <nav aria-label="Social links">
    <a href={contact.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
    <a href={contact.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
    <a href={contact.x} target="_blank" rel="noopener noreferrer">X ↗</a>
    <BookCallLink />
  </nav>
  <p class="footer-sign meta-label">© {year} Pruthviraj Mane · {data.profile.city}</p>
</footer>
