---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import BookCallDialog from '../components/BookCallDialog.astro';
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  current?: 'home' | 'experience' | 'research' | 'projects' | 'blogs' | 'about';
  noIndex?: boolean;
  image?: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown>;
}
const { title, description, current, noIndex = false, image = '/og.png', type = 'website', jsonLd } = Astro.props;
const pageTitle = title === 'Home' ? 'Pruthviraj Mane — Robotics Engineer' : `${title} — Pruthviraj Mane`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#FBF8F0" />
    <meta name="description" content={description} />
    {noIndex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical.href} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{pageTitle}</title>
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Pruthviraj Mane" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@pruthvi_mane_" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <canvas class="backdrop" aria-hidden="true"></canvas>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader current={current} />
    <main id="main"><slot /></main>
    <SiteFooter />
    <BookCallDialog />
    <script>
      import '../scripts/copy';
      import '../scripts/navigation';
      import '../scripts/book-call';
      import '../scripts/backdrop';
    </script>
  </body>
</html>
