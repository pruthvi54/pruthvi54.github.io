---
import SiteLayout from '../../layouts/SiteLayout.astro';
import data from '../../data/content.json';
const profile = data.profile;
const sections = [
  { id: 'work', title: 'Work', entries: profile.experience },
  { id: 'education', title: 'Education', entries: profile.education }
];
---
<SiteLayout title="Experience" description="Pruthviraj Mane's experience in robotics, simulation and autonomous systems: QibiTech, IISc AIRL, IIT Guwahati and Walchand College of Engineering." current="experience">
  <div class="experience-page page-width">
    <div class="page-intro">
      <h1 class="page-title">Experience</h1>
      <p class="page-subtitle">{profile.experienceIntro}</p>
    </div>
    {sections.map((section) => <section class="about-section" id={section.id} aria-labelledby={`${section.id}-title`}>
      <h2 id={`${section.id}-title`}>{section.title}</h2>
      <div class="about-section-body">{section.entries.map((entry) => <article class="experience-entry">
        <header class="experience-head">
          <div>
            <h3>{entry.title}</h3>
            <p class="experience-org">{entry.location ? `${entry.organization} · ${entry.location}` : entry.organization}</p>
          </div>
          <span class="meta-label experience-date">{entry.date}</span>
        </header>
        {entry.groups.map((group) => <div class="experience-group">
          {group.heading && <h4 class="meta-label">{group.heading}</h4>}
          <ul>{group.items.map((item) => <li>{item}</li>)}</ul>
        </div>)}
        {entry.tags.length > 0 && <p class="experience-tags meta">{entry.tags.join(' / ')}</p>}
      </article>)}</div>
    </section>)}
  </div>
</SiteLayout>
